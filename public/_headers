# Only this site's own scripts run (plus the inline ones in the pages), and the browser only talks to
# this site (the store API is reached through src/worker.js). YouTube's privacy-enhanced player may be
# framed once someone presses play.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images, icons, site.css and site.js: browsers keep them for a day, then refresh them in the background.
# The pages load site.css and site.js as ?v=YYYYMMDD, so bump that number in every page when you edit
# either file and visitors get the new version immediately.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
