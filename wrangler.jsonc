{
  "name": "gcsware",
  "account_id": "15501adf41bdfa88f04324a8c7b0814c",
  "compatibility_date": "2026-10-10",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Unknown URLs get public/404.html (with a 404 status) instead of an empty response
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "gcsware.com", "custom_domain": true }
  ]
}
